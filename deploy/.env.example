# Smart Recruit Match — environment for deploy/docker-compose.yml
# Copy to deploy/.env (gitignored) and change every password before sharing the machine.
# Full table: DEPLOY.md › Biến môi trường. Developer notes: docs/SETUP.md › Biến môi trường.

# PostgreSQL (added in v0.1.0)
# Superuser and database created on first start of the postgres volume.
POSTGRES_USER=srm
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=srm

# RabbitMQ (added in v0.1.0)
# Default user created on first start of the rabbitmq volume; management UI at http://localhost:15672.
# Compose builds RABBITMQ_URL for api, ai-worker and ai-api from these two (v0.7.0, CONTEXT D33), so
# the password must be URL-safe (letters, digits, - _ . ~). Set RABBITMQ_URL yourself only when
# running the API outside Docker, with the host port from RABBITMQ_HOST_PORT:
# RABBITMQ_URL=amqp://srm:change-me-rabbitmq@localhost:5672
RABBITMQ_DEFAULT_USER=srm
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq

# Object storage — MinIO or any S3-compatible service (added in v0.1.0, CONTEXT D23)
# The bundled minio service uses ACCESS_KEY/SECRET_KEY as its root credentials (secret: 8+ chars).
# To use an external MinIO/S3 instead, point MINIO_ENDPOINT at it and use that service's keys.
# Inside compose the API reaches the bundled service at http://minio:9000; from the host use http://localhost:9000.
# The API creates the buckets jd-files and cv-files on its first upload and encrypts every object
# with SSE-S3 (v0.4.0, CONTEXT D28). MINIO_BUCKET is no longer read; remove it from deploy/.env.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=srm-minio
MINIO_SECRET_KEY=change-me-minio
# Address browsers use for file downloads (presigned URLs valid 5 minutes, v0.4.0, CONTEXT D29).
# A signature covers the host, so this must be exactly the address users open the web app at:
# nginx forwards /jd-files/ and /cv-files/ to minio. Default: http://localhost:<NGINX_PORT>.
# On a server, set the public URL of the site, e.g. https://srm.example.edu.vn.
MINIO_PUBLIC_ENDPOINT=http://localhost:8080
# Encryption key of the bundled minio service (v0.4.0, CONTEXT D28): SSE-S3 needs one.
# Format `<name>:<base64 of 32 random bytes>`, e.g. `srm-key:` followed by `openssl rand -base64 32`.
# Required: compose refuses to start while it is empty. Losing or changing it makes stored files
# unreadable; back it up together with the minio volume.
MINIO_KMS_SECRET_KEY=

# Web entry point (added in v0.1.0)
# Host port where nginx serves the SPA and proxies /api.
NGINX_PORT=8080

# Host ports for infrastructure services (added in v0.1.0)
# Published on 127.0.0.1 only, for tools and for running the API outside Docker.
# Change a value when the port is already taken on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
# FastAPI of the AI Service, GET /health (added in v0.7.0, CONTEXT D33).
AI_API_HOST_PORT=8000

# Core Backend database (added in v0.1.1, CONTEXT D24)
# Compose builds DATABASE_URL for the migrate and api services from POSTGRES_* (host `postgres`),
# so POSTGRES_PASSWORD must be URL-safe (letters, digits, - _ . ~). Set DATABASE_URL yourself only
# when running the API or `db:migrate` outside Docker, with the host port from POSTGRES_HOST_PORT:
# DATABASE_URL=postgres://srm:change-me-postgres@localhost:5432/srm

# Database roles of the services (added in v0.7.0, CONTEXT D33)
# Migration 0006 creates api_service (the API: reads and writes core, reads ai) and ai_service
# (the AI Service: reads only the PII-free views core.v_ai_*, reads and writes ai). The migrate
# service sets their login passwords from these values on every start, so changing one here and
# running `up` again is enough. The api service connects as api_service, migrate as POSTGRES_USER.
# Required: compose refuses to start while they are empty. At least 12 URL-safe characters
# (letters, digits, - _ . ~), because they go into connection URLs.
API_DB_PASSWORD=change-me-api-service
AI_DB_PASSWORD=change-me-ai-service

# Authentication (added in v0.2.0, CONTEXT D25)
# HS256 key for 15-minute access tokens: at least 32 random characters, e.g. `openssl rand -base64 48`.
# Required: compose refuses to start while it is empty, and the API refuses values starting with change-me.
# Changing it signs everyone out within 15 minutes (refresh tokens stay valid).
JWT_ACCESS_SECRET=
# Lifetime of refresh tokens (httpOnly cookie, stored hashed in Redis), in days.
REFRESH_TOKEN_TTL_DAYS=7
# Compose sets REDIS_URL=redis://redis:6379 for the api service. Set it yourself only when running
# the API outside Docker, with the host port from REDIS_HOST_PORT:
# REDIS_URL=redis://localhost:6379
# Password of the accounts created by `pnpm --filter @srm/api db:seed` (dev/test data only).
# SEED_PASSWORD=Srm-Dev-12345

# Scheduled jobs (added in v0.3.0, CONTEXT D27)
# Cron jobs of the API, e.g. moving campaigns to the next phase when a deadline passes. Keep true;
# with several API instances a PostgreSQL advisory lock lets only one of them run each job.
SCHEDULER_ENABLED=true

# Email and links (added in v0.6.0, CONTEXT D31)
# Address users open the web app at, without a trailing slash. Links in emails (HR invitations,
# notifications) start with it. Default: http://localhost:<NGINX_PORT>. On a server, set the
# public URL of the site, e.g. https://srm.example.edu.vn.
WEB_ORIGIN=http://localhost:8080
# SMTP server for notification emails. The default is the bundled mailpit service, which catches
# every email (UI at http://localhost:<MAILPIT_UI_HOST_PORT>). Port 465 uses implicit TLS.
# Failed emails are retried twice (after 1 and 5 minutes), then marked FAILED in the log.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Leave empty when the SMTP server needs no login (mailpit).
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Smart Recruit Match <no-reply@srm.local>

# LLM of the AI Service (added in v0.9.0, CONTEXT D34, D35)
# ai-worker calls the LLM through LLMClient. The default `fixture` answers only recorded test
# requests: the stack starts without a key, and every real JD analysis fails, so HR enters the
# requirements by hand. To analyse JDs, set LLM_PROVIDER=gemini and GEMINI_API_KEY (free tier:
# synthetic data only, CONTEXT D34), or LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.
LLM_PROVIDER=fixture
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Overrides the provider's default model (gemini-3.8-flash / claude-opus-5-5); empty = default.
LLM_MODEL=

# Core Backend (added in v0.1.0)
# pino log level: fatal | error | warn | info | debug | trace | silent
# The AI Service reads it too (trace → DEBUG, fatal and silent → CRITICAL), since v0.7.0.
LOG_LEVEL=info
