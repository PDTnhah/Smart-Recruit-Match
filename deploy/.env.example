# Smart Recruit Match — environment for deploy/docker-compose.yml
# Copy to deploy/.env (gitignored) and change every password before sharing the machine.
# Full table: DEPLOY.md › Biến môi trường. Developer notes: docs/SETUP.md › Biến môi trường.

# PostgreSQL (added in v0.1.0)
# Superuser and database created on first start of the postgres volume.
POSTGRES_USER=srm
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=srm

# RabbitMQ (added in v0.1.0)
# Default user created on first start of the rabbitmq volume; management UI at http://localhost:15672.
RABBITMQ_DEFAULT_USER=srm
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq

# Object storage — MinIO or any S3-compatible service (added in v0.1.0, CONTEXT D23)
# The bundled minio service uses ACCESS_KEY/SECRET_KEY as its root credentials (secret: 8+ chars).
# To use an external MinIO/S3 instead, point MINIO_ENDPOINT at it and use that service's keys.
# Inside compose the API reaches the bundled service at http://minio:9000; from the host use http://localhost:9000.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=srm-minio
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=srm-files

# Web entry point (added in v0.1.0)
# Host port where nginx serves the SPA and proxies /api.
NGINX_PORT=8080

# Host ports for infrastructure services (added in v0.1.0)
# Published on 127.0.0.1 only, for tools and for running the API outside Docker.
# Change a value when the port is already taken on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# Core Backend (added in v0.1.0)
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
