{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./questions_generate_output.json",
  "type": "object",
  "properties": {
    "bank_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.question_banks.id of the job"
    },
    "questions": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "$ref": "./generated_question.json"
      },
      "description": "Every draft of the bank"
    },
    "missing_cells": {
      "maxItems": 360,
      "type": "array",
      "items": {
        "$ref": "./missing_cell.json"
      },
      "description": "Cells with fewer drafts than they need; empty when the bank is complete"
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "LLM rounds the job ran"
    }
  },
  "required": [
    "bank_id",
    "questions",
    "missing_cells",
    "rounds"
  ],
  "additionalProperties": false,
  "title": "QuestionsGenerateOutput",
  "description": "Result of QUESTIONS_GENERATE"
}
