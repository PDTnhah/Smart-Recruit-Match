{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./questions_validate_output.json",
  "type": "object",
  "properties": {
    "bank_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.question_banks.id of the job"
    },
    "verdicts": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "$ref": "./question_verdict.json"
      },
      "description": "One verdict per draft that has one"
    },
    "unchecked": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "description": "Draft ids of the job left without a verdict; empty when every draft has one"
    }
  },
  "required": [
    "bank_id",
    "verdicts",
    "unchecked"
  ],
  "additionalProperties": false,
  "title": "QuestionsValidateOutput",
  "description": "Result of QUESTIONS_VALIDATE"
}
