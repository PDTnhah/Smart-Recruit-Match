{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./cv_verify_generate_output.json",
  "type": "object",
  "properties": {
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "Versioned prompt file, e.g. cv_verification/v1"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id that produced the questions"
    },
    "preference_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.preferences.id of the job"
    },
    "questions": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "./cv_verification_question.json"
      }
    }
  },
  "required": [
    "prompt_version",
    "model",
    "preference_id",
    "questions"
  ],
  "additionalProperties": false,
  "title": "CvVerifyGenerateOutput",
  "description": "Result of CV_VERIFY_GENERATE"
}
