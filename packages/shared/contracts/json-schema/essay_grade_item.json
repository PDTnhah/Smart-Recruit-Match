{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./essay_grade_item.json",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.exam_sessions.id"
    },
    "question_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.questions.id of the essay"
    },
    "pass_no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "Which of the two independent gradings, 1 or 2"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id that produced this grade"
    },
    "grading": {
      "$ref": "./grading_result.json"
    }
  },
  "required": [
    "session_id",
    "question_id",
    "pass_no",
    "model",
    "grading"
  ],
  "additionalProperties": false,
  "title": "EssayGradeItem",
  "description": "One pass of the Grader over one answer, points checked"
}
