{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./cv_verification_check_item.json",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Id of the question, as the prompt gives it"
    },
    "verdict": {
      "$ref": "./cv_llm_verdict.json"
    },
    "quote": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ],
      "description": "Words copied from the answer that support the verdict; required for CONSISTENT and PARTIAL"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Why this verdict, in Vietnamese"
    }
  },
  "required": [
    "question_id",
    "verdict",
    "quote",
    "reason"
  ],
  "additionalProperties": false,
  "title": "CvVerificationCheckItem",
  "description": "The verdict on one answer of part D"
}
