{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./questions_validate_job.json",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this job; the AI Service processes each job_id once (AD-5)"
    },
    "bank_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.question_banks.id the drafts belong to"
    },
    "draft_ids": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "description": "ai.question_drafts.id of the DRAFT questions to check, without duplicates"
    }
  },
  "required": [
    "job_id",
    "bank_id",
    "draft_ids"
  ],
  "additionalProperties": false,
  "title": "QuestionsValidateJob",
  "description": "Job on ai.questions.validate: check the unchecked drafts of a bank"
}
