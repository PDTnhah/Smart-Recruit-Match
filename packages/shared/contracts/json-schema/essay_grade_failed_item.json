{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./essay_grade_failed_item.json",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.exam_sessions.id"
    },
    "question_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.questions.id of the essay"
    },
    "pass_no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "Which of the two independent gradings, 1 or 2"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Why there is no grade, e.g. LLM_REFUSAL, INVALID_OUTPUT, GRADING_OUT_OF_RANGE, EXPIRED, SOURCE_MISSING"
    },
    "needs_review": {
      "type": "boolean",
      "description": "The LLM refused the answer again when sent on its own"
    }
  },
  "required": [
    "session_id",
    "question_id",
    "pass_no",
    "code",
    "needs_review"
  ],
  "additionalProperties": false,
  "title": "EssayGradeFailedItem",
  "description": "One pass of an ESSAY_GRADE job left without a grade"
}
