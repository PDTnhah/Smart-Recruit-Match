{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./essay_grade_output.json",
  "type": "object",
  "properties": {
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "Versioned prompt of every grade of the job, e.g. grader/v1"
    },
    "final": {
      "type": "boolean",
      "description": "Last message of the job"
    },
    "items": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "$ref": "./essay_grade_item.json"
      }
    },
    "failed": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "$ref": "./essay_grade_failed_item.json"
      },
      "description": "Passes left without a grade, in any message of the job"
    }
  },
  "required": [
    "prompt_version",
    "final",
    "items",
    "failed"
  ],
  "additionalProperties": false,
  "title": "EssayGradeOutput",
  "description": "One message of the result of ESSAY_GRADE"
}
