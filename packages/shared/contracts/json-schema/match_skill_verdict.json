{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./match_skill_verdict.json",
  "type": "object",
  "properties": {
    "skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Skill name exactly as the JD requirements list it"
    },
    "level_required": {
      "$ref": "./skill_level.json"
    },
    "verdict": {
      "$ref": "./match_verdict.json"
    },
    "evidence": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ],
      "description": "Quote copied from the CV that supports the verdict; null when NOT_MET"
    }
  },
  "required": [
    "skill",
    "level_required",
    "verdict",
    "evidence"
  ],
  "additionalProperties": false,
  "title": "MatchSkillVerdict",
  "description": "Verdict on one skill of the JD, with evidence from the CV"
}
