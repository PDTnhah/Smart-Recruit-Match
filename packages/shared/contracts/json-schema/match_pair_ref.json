{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./match_pair_ref.json",
  "type": "object",
  "properties": {
    "cv_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.cvs.id; each CV version has its own row"
    },
    "cv_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.cvs.version of that row"
    },
    "jd_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.job_descriptions.id"
    },
    "jd_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.job_descriptions.version the code part was computed for"
    }
  },
  "required": [
    "cv_id",
    "cv_version",
    "jd_id",
    "jd_version"
  ],
  "additionalProperties": false,
  "title": "MatchPairRef",
  "description": "One CV × JD pair of a matching run"
}
