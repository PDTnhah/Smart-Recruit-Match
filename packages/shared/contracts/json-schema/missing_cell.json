{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./missing_cell.json",
  "type": "object",
  "properties": {
    "type": {
      "$ref": "./question_type.json"
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Skill of the blueprint cell"
    },
    "difficulty": {
      "$ref": "./question_difficulty.json"
    },
    "drafted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Drafts the bank holds for the cell"
    },
    "required": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Drafts the cell needs: 3 × its count"
    }
  },
  "required": [
    "type",
    "skill",
    "difficulty",
    "drafted",
    "required"
  ],
  "additionalProperties": false,
  "title": "MissingCell",
  "description": "A blueprint cell with fewer drafts than it needs"
}
