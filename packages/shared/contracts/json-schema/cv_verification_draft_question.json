{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./cv_verification_draft_question.json",
  "type": "object",
  "properties": {
    "claim_ref": {
      "$ref": "./cv_claim_ref.json"
    },
    "stem": {
      "type": "string",
