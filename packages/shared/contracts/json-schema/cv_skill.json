{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./cv_skill.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Skill name as the CV writes it"
    },
    "canonical_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ],
      "description": "Name of the catalogue skill it maps to; null when match is NEW"
    },
    "match": {
      "$ref": "./skill_match.json"
    }
  },
  "required": [
    "name",
    "canonical_name",
    "match"
  ],
  "additionalProperties": false,
  "title": "CvSkill",
  "description": "One concrete skill the CV claims, mapped to the skill catalogue"
}
