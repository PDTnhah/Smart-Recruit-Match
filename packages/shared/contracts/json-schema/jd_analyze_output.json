{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./jd_analyze_output.json",
  "type": "object",
  "properties": {
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "Versioned prompt file, e.g. cv_parser/v3"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id that produced the output"
    },
    "jd_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "core.job_descriptions.id the requirements belong to"
    },
    "jd_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "JD version that was analysed"
    },
    "requirements": {
      "$ref": "./jd_requirements.json"
    },
    "position_group": {
      "$ref": "./position_group.json"
    },
    "new_skills": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "description": "Skill names not in the catalogue (match NEW), one per skillMatchKey, as written"
    },
    "hidden_text_detected": {
      "type": "boolean",
      "description": "The JD file contained hidden text, removed before the prompt"
    }
  },
  "required": [
    "prompt_version",
    "model",
    "jd_id",
    "jd_version",
    "requirements",
    "position_group",
    "new_skills",
    "hidden_text_detected"
  ],
  "additionalProperties": false,
  "title": "JdAnalyzeOutput",
  "description": "Result of JD_ANALYZE"
}
