{
  "name": "smart-recruit-match",
  "version": "0.1.1",
  "private": true,
  "description": "Smart Recruit Match — monorepo (apps/api, apps/web, packages/shared, ai-service)",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @srm/shared build && pnpm -r typecheck",
    "lint": "pnpm --filter @srm/shared build && pnpm -r lint",
    "test": "pnpm -r test",
    "depcruise": "depcruise apps/api/src --config .dependency-cruiser.cjs",
    "depcruise:fixture": "sh scripts/check-depcruise-fixture.sh",
    "docs:validate": "koni-docs validate --docs-path docs/",
    "docs:sync": "koni-docs sync --docs-path docs/",
    "docs:status": "koni-docs status --docs-path docs/"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@koniverse/koni-docs": "0.12.0",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
