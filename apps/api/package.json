{
  "name": "@srm/api",
  "version": "0.2.0",
  "private": true,
  "description": "Core Backend — NestJS modular monolith",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration",
    "db:generate": "pnpm --filter @srm/shared build && drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/db/migrate.js",
    "db:seed": "tsc -p tsconfig.build.json && node dist/db/seed/dev-seed.js",
    "openapi:export": "tsc -p tsconfig.build.json && node dist/openapi/export.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@srm/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "12.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "ts-jest": "29.4.14"
  }
}
