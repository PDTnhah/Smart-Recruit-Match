{
  "name": "@srm/api",
  "version": "0.1.0",
  "private": true,
  "description": "Core Backend — NestJS modular monolith",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
